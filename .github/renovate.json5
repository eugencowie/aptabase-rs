{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "schedule:weekly",
    "security:minimumReleaseAgeCrate",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
  ],
  ignorePresets: [":pinDevDependencies"],
  labels: ["chore"],

  packageRules: [
    {
      description: "The Rust toolchain is pinned to the MSRV, so only bump it by hand",
      matchManagers: ["mise"],
      matchDepNames: ["rust"],
      enabled: false,
    },
    {
      description: "release-plz tags its CLI releases release-plz-vX.Y.Z",
      matchManagers: ["mise"],
      matchDepNames: ["release-plz"],
      extractVersion: "^release-plz-v(?<version>.+)$",
    },
  ],
}
